# Other repos for evaluating/validating tooling changes
external/

# Generated eval reports are to be committed once generated (Q-071 [1]; none
# yet): the report and every
# sidecar the suites read to grade it (.stamp freshness, .failed marker,
# .transcript.jsonl for tool-call checks). Anything else a run might leave in
# output/ stays ignored.
test/skills/*/output/*
!test/skills/*/output/*.report.md
!test/skills/*/output/*.stamp
!test/skills/*/output/*.failed
!test/skills/*/output/*.transcript.jsonl

# Process artifacts from self-improvement rounds (kept locally for reference)
docs/working/archive/

# Self-improvement code-review rubric archive: a local-only calibration corpus
# (Q-036). scripts/self-improvement.sh writes it; it is never committed.
docs/working/reviews/round-*/

# Generated per-round and per-task working docs (reduce git status noise)
docs/working/*.json
docs/working/*.log
docs/working/summary-*.md
docs/working/plan-*.md
docs/working/research-*.md
docs/working/feature-ideas-round-*.md
docs/working/external-ideas-candidates.md
docs/working/hypothesis-log.md
docs/working/si-input.md
docs/working/completed-tasks.md
docs/working/morning-summary.md
docs/working/simplify-followup.md
docs/working/*.txt
docs/working/scratch/

# Worktree directory (managed by Claude Code, not for tracking)
.claude/

# Personal notes
ideas.txt

# WSL/Windows Defender zone-identifier metadata stubs
*:Zone.Identifier

# Staged image payload, regenerated by devcontainer-config/install.sh on every run
devcontainer-config/claude-home/
__pycache__/

# Stage-1 dry-run/live prompt snapshots are whole-repo (or foreign-repo) content shipped
# to third-party APIs — never commit them (security finding A6, 2026-07-31 review).
runs/**/prompt.txt
# Same rule, same reason: a headless run's stream transcript is a strict SUPERSET of
# prompt.txt — it quotes every file the agent read, verbatim, from repositories we do
# not own. The CRB arm would add 50 of these. (2026-08-18 review, finding A4.)
# NOTE the 16 transcripts already committed under runs/review-arms/e7-fable-3x/ predate
# this rule and stay tracked; this prevents new ones, it does not rewrite history.
runs/**/transcript.jsonl
runs/**/stderr.log
runs/review-arms/e1/wt-*
runs/review-arms/e3-loops/wt-*
runs/review-arms/baseline-2026-08-06/wt-*
