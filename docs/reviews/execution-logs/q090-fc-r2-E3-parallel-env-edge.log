# ---- e3.sh ----
#!/usr/bin/env bash
# Probe: $PARALLEL / config that makes `parallel --version` fail, and an uncreatable .bats/parallel-home.
set -u
WT=/workspace/.claude/wt-run-tests-jobs
S=$1; KIND=$2
T="$S/$KIND/my repo"; H="$S/$KIND/home"
rm -rf "$S/$KIND"; mkdir -p "$T/scripts" "$T/test/skills" "$T/test/lib" "$T/test/sub" "$H" "$S/$KIND/shim"
cp "$WT/scripts/run-tests.sh" "$T/scripts/"; cp "$WT/test/skills/runner-contract.bash" "$T/test/skills/"; cp "$WT/test/lib/hermetic-env.bash" "$T/test/lib/"
printf '%s\n' '#!/usr/bin/env bats' '# @category fast' '@test "gamma clean output" { true; }' > "$T/test/gamma.bats"
printf '%s\n' '#!/usr/bin/env bats' '# @category slow' '@test "beta steady" { true; }' > "$T/test/sub/beta.bats"
# shim: log PARALLEL_HOME/PARALLEL seen by each parallel call, then exec the real one
printf '%s\n' '#!/usr/bin/env bash' "echo \"shim: args=[\$*] PARALLEL_HOME=[\${PARALLEL_HOME-unset}] PARALLEL=[\${PARALLEL-unset}]\" >> '$S/$KIND/shim.log'" 'exec /usr/bin/parallel "$@"' > "$S/$KIND/shim/parallel"; chmod +x "$S/$KIND/shim/parallel"
envx=()
case $KIND in
  env-bogus) envx=(PARALLEL=--no-such-option) ;;
  config-bogus) mkdir -p "$H/.parallel"; echo '--no-such-option' > "$H/.parallel/config" ;;
  home-uncreatable) mkdir -p "$T/.bats"; : > "$T/.bats/parallel-home"; envx=(PARALLEL_HOME="$H/users-own") ;;
esac
echo "## KIND=$KIND"
timeout 60 env -i PATH="$S/$KIND/shim:/usr/local/bin:/usr/bin:/bin" HOME="$H" TMPDIR="$S" LC_ALL=C.UTF-8 "${envx[@]}" bash "$T/scripts/run-tests.sh" --jobs 2 test/gamma.bats test/sub/beta.bats 3>&-
echo "## exit=$?"
cat "$S/$KIND/shim.log" 2>/dev/null
