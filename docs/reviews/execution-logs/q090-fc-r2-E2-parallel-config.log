# ---- e2.sh ----
#!/usr/bin/env bash
# Probe: does a user's ~/.parallel/config (or ~/.parallelrc, $XDG_CONFIG_HOME/parallel/config) reach bats' parallel under run-tests.sh --jobs 2?
set -u
WT=/workspace/.claude/wt-run-tests-jobs
S=$1; KIND=$2
T="$S/$KIND/my repo"; H="$S/$KIND/home"
rm -rf "$S/$KIND"; mkdir -p "$T/scripts" "$T/test/skills" "$T/test/lib" "$T/test/sub" "$H"
cp "$WT/scripts/run-tests.sh" "$T/scripts/"; cp "$WT/test/skills/runner-contract.bash" "$T/test/skills/"; cp "$WT/test/lib/hermetic-env.bash" "$T/test/lib/"
printf '%s\n' '#!/usr/bin/env bats' '# @category fast' '@test "gamma clean output" { true; }' > "$T/test/gamma.bats"
printf '%s\n' '#!/usr/bin/env bats' '# @category slow' '@test "beta steady" { true; }' > "$T/test/sub/beta.bats"
envx=()
case $KIND in
  home-dot-parallel) mkdir -p "$H/.parallel"; echo '--dry-run' > "$H/.parallel/config" ;;
  parallelrc) echo '--dry-run' > "$H/.parallelrc" ;;
  xdg) mkdir -p "$H/xdg/parallel"; echo '--dry-run' > "$H/xdg/parallel/config"; envx=(XDG_CONFIG_HOME="$H/xdg") ;;
  control) : ;;
esac
echo "## KIND=$KIND"
timeout 60 env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$H" TMPDIR="$S" LC_ALL=C.UTF-8 "${envx[@]}" bash "$T/scripts/run-tests.sh" --jobs 2 test/gamma.bats test/sub/beta.bats 3>&-
echo "## exit=$?"
ls -a "$T/.bats/parallel-home" 2>&1 | tr '\n' ' '; echo
