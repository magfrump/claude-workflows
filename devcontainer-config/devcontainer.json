{
  // Central, project-agnostic devcontainer config (decision 016).
  //
  // This file is NOT meant to live in a target repo. It is installed to
  // ~/.config/claude-devcontainer/ by install.sh and passed to the CLI with
  // `--override-config`, so it sits outside every bind mount and no session can
  // edit the boundary it runs under.
  //
  // BUILD PATHS MUST BE ABSOLUTE. Under `--override-config` the CLI reads this
  // file's *content* but sets the config's configFilePath to the WORKSPACE's
  // .devcontainer/devcontainer.json (configContainer.ts: `config.configFilePath =
  // configFile`). Relative build paths therefore resolve against the target repo,
  // not this directory: a bare "Dockerfile" means <repo>/.devcontainer/Dockerfile.
  // In a repo without one that is a hard "Dockerfile not found"; in a repo that
  // HAS one it silently builds the repo's own Dockerfile and bakes the repo's
  // agent-writable init-firewall.sh into the image — H2 defeated, silently.
  // Anchoring both paths to $CC_CONFIG_DIR keeps the build context in the config
  // dir, which is in no bind mount. Never make these relative again.
  //
  // The ${localEnv:*} values are exported by cc-isolated.sh before it invokes the
  // CLI. They are what make one config serve N projects.
  "name": "cc-isolated (${localEnv:CC_PROJECT_NAME})",

  "build": {
    "dockerfile": "${localEnv:CC_CONFIG_DIR}/Dockerfile",
    "context": "${localEnv:CC_CONFIG_DIR}",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0",
      "UV_VERSION": "0.11.28",
      "RUSTUP_VERSION": "1.27.1",
      "RUST_VERSION": "1.83.0",
      "ANDROID_CMDLINE_TOOLS_VERSION": "11076708",
      "ANDROID_CMDLINE_TOOLS_SHA256": "2d2d50857e4eb553af5a6dc3ad507a17adf43d115264b1afc116f95c92e5e258",
      "ANDROID_PLATFORM": "android-35",
      "ANDROID_BUILD_TOOLS": "35.0.0",
      "DOTNET_SDK_VERSION": "10.0.400",
      "DOTNET_SDK_SHA512_AMD64": "1033977dd837150e0814cf0c5d5b17ceb63925fda7ba2158b47258a4bd7c048cf82eac3bc1166f3146f53124a3f5fba09db1de1260d2ce96399860303b404b48",
      "DOTNET_SDK_SHA512_ARM64": "a1b45da58e5591fff909a6126ac6bfc1ef9c12bc72c0625f7815e83a82be1a902317ee96926cbbf81324a45c6abf2ed8102a216d0507879cc166159af78d1b77",
      "CC_EGRESS_PROFILE": "${localEnv:CC_EGRESS_PROFILE}"
    }
  },

  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  "remoteUser": "node",

  // Volumes are keyed on CC_PROJECT_ID (a hash of the target repo's absolute path),
  // so each project gets its OWN /home/node/.claude. Decision 016 H6: sharing one
  // volume across projects would let a compromised session in project A read
  // project B's credentials, memory, and session history.
  "mounts": [
    "source=cc-${localEnv:CC_PROJECT_ID}-bashhistory,target=/commandhistory,type=volume",
    "source=cc-${localEnv:CC_PROJECT_ID}-claude-config,target=/home/node/.claude,type=volume"
  ],

  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    // Read by the launcher's post-start volume-identity assertion.
    "CC_PROJECT_ID": "${localEnv:CC_PROJECT_ID}",
    "GIT_AUTHOR_NAME": "magfrump",
    "GIT_AUTHOR_EMAIL": "magfrump@gmail.com",
    "GIT_COMMITTER_NAME": "magfrump",
    "GIT_COMMITTER_EMAIL": "magfrump@gmail.com",

    // Opt-in, and empty unless the host exports it. Only meaningful in a project
    // registered with the `llm` egress profile — without that, openrouter.ai is
    // firewalled and the key is inert.
    //
    // This is a real credential inside the sandbox: anything the agent can put in
    // a prompt leaves the boundary, and a key in the container is a key a
    // compromised session can exfiltrate through the very channel `llm` opens.
    // Export it only for the session that needs it
    // (`OPENROUTER_API_KEY=... cc-isolated`), prefer a spend-capped key, and
    // revoke after. The long-term fix is a host-side key broker.
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  // Firewall first (it is the boundary), then link the baked claude-workflows
  // payload into this project's ~/.claude volume (decision 022). The link step
  // runs unprivileged as `node` and is idempotent, so it is safe to re-run on
  // every start; `&&` means a firewall failure still aborts the session.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && /usr/local/bin/link-claude-home.sh",
  "waitFor": "postStartCommand"
}
